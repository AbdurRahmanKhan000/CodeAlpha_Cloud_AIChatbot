{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "codealpha_aichatbot",
          "format": "url",
          "env": "CODEALPHA_AICHATBOT_URL"
        }
      ]
    },
    "codealpha_aichatbot": {
      "root": "CodeAlpha_AIChatbot",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "codealpha_aichatbot"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
